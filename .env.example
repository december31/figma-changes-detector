# Figma Personal Access Token (optional if entered directly in the web UI)
# Generate from Figma: Account Settings -> Security -> scroll down to Personal access tokens
FIGMA_ACCESS_TOKEN=

# Port to run the server on (default: 3000)
PORT=3000

# Atlassian Collab (Confluence) Configuration
COLLAB_URL=http://collab.lge.com/main
COLLAB_TOKEN=

