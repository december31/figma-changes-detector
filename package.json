{
  "name": "figma-changes-detector",
  "version": "1.0.0",
  "description": "Figma Changes Detector - Monorepo with React TSX client and Express server",
  "main": "electron-main.js",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "prestart": "npm run build",
    "start": "node server/server.js",
    "dev": "npx --yes concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "generate:icons": "node scripts/generate-icons.js",
    "build:client": "node scripts/generate-icons.js && npm --prefix client run build",
    "build": "npm run build:client",
    "electron:dev": "npm run build:client && electron .",
    "prebuild:win": "npm run build:client && node scripts/prepare-win-sharp.js",
    "build:win": "electron-builder --win --x64"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "^0.35.5"
  },
  "build": {
    "appId": "com.anthony.figmachangesdetector",
    "productName": "Figma Changes Detector",
    "directories": {
      "output": "dist-electron"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "files": [
      "electron-main.js",
      "build/**/*",
      "server/**/*",
      "client/dist/**/*",
      "!server/assets/**/*",
      "!server/data.db*",
      "!server/datasources/**/*",
      "!server/datasources.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
